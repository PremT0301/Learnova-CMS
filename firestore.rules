rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{docId} {
      allow read: if isSignedIn();
      // Create own user profile at signup with strict constraints
      allow create: if isSignedIn() && request.auth.uid == docId &&
        // email must match auth email (case-insensitive)
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        // role can only be 'student' or 'faculty' at signup (never 'admin')
        request.resource.data.role in ['student', 'faculty'] &&
        // activation rules: students active true, faculty active false
        (
          (request.resource.data.role == 'student' && request.resource.data.active == true) ||
          (request.resource.data.role == 'faculty' && request.resource.data.active == false)
        );

      // Admin may update any user fields, including role/active
      allow update, delete: if isAdmin();

      // User may update own non-privileged fields only (not role/active/email)
      allow update: if isSignedIn() && request.auth.uid == docId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.email == resource.data.email;
    }

    // Courses collection
    match /courses/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.instructorId == request.auth.uid);
    }

    // Assignments collection
    match /assignments/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.facultyId == request.auth.uid);
    }

    // Submissions collection
    match /submissions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student');
      allow update: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
    }

    // Notifications collection
    match /notifications/{docId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Departments, Settings, Audit Logs, Announcements, Backups, Roles, Support Tickets
    match /departments/{docId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /settings/{docId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /system_config/{docId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /audit_logs/{docId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /announcements/{docId} { 
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'faculty']);
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }
    match /backups/{docId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /roles/{docId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /support_tickets/{docId} { allow read, write: if isAdmin(); }

    // Faculty signup verification requests
    match /faculty_requests/{docId} {
      // requester can create one pending request under their uid
      allow create: if isSignedIn() && docId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Admins can read all; requester can read their own
      allow read: if isAdmin() || (isSignedIn() && docId == request.auth.uid);
      // Only admins can update status (approve/reject)
      allow update: if isAdmin();
      // No deletes except admins
      allow delete: if isAdmin();
    }

    // Faculty-specific collections
    match /faculty_profiles/{docId} {
      allow read: if isSignedIn() && (docId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && docId == request.auth.uid;
    }
    
    match /course_enrollments/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Fallback: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}